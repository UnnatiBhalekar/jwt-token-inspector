{
  "manifest_version": 3,
  "name": "JWT Inspector & Token Debugger",
  "description": "A security-first Chrome extension for locally inspecting JSON Web Tokens (JWTs).",
  "version": "0.1.0",

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["activeTab", "tabs", "storage", "downloads", "webRequest"],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
